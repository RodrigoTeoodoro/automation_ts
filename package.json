{
    "name": "automation",
    "version": "1.0.0",
    "description": "Mobile automation tests",
    "main": "index.js",
    "bootstrap": "./server.js",
    "scripts": {
        "android": "codeceptjs run --reporter mochawesome -c codecept.conf.js --override '{\"helpers\": {\"Appium\": { \"platform\": \"Android\", \"app\": \"/Users/qazando/Documents/app-release.apk\", \"desiredCapabilities\": { \"appPackage\": \"com.qazandoapp\", \"appActivity\": \"MainActivity\", \"deviceName\": \"pixel\", \"platformVersion\": \"9\" }}}} ' ",
        "test": "codeceptjs run --steps",
        "tests": "codeceptjs run --steps",
        "codeceptjs": "codeceptjs run --steps",
        "codeceptjs:headless": "HEADLESS=true codeceptjs run --steps",
        "codeceptjs:ui": "codecept-ui --app",
        "codeceptjs:demo": "codeceptjs run --steps -c node_modules/@codeceptjs/examples",
        "codeceptjs:demo:headless": "HEADLESS=true codeceptjs run --steps -c node_modules/@codeceptjs/examples",
        "codeceptjs:demo:ui": "codecept-ui --app  -c node_modules/@codeceptjs/examples"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@wdio/cli": "^9.12.7",
        "casual": "^1.6.2",
        "mocha-multi": "^1.1.7",
        "mochawesome": "^7.1.3",
        "node-random-name": "^1.0.1",
        "random-number": "0.0.9"
    },
    "devDependencies": {
        "@codeceptjs/configure": "^1.0.1",
        "@codeceptjs/examples": "^1.2.4",
        "@codeceptjs/ui": "^1.2.0",
        "@wdio/appium-service": "^9.12.7",
        "appium": "^2.18.0",
        "codeceptjs": "^3.7.3",
        "mocha": "^10.2.0",
        "playwright": "^1.44.1",
        "webdriverio": "^9.12.7"
    }
